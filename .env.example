# ---------------------------------------------------------------------------
# 智谱 GLM（推荐）：Key 只在 Node 侧使用，不会打包进前端
#   1. https://bigmodel.cn  → 「API Key」→ 新建
#   2. 复制本文件为 .env.local，填入 ZHIPU_API_KEY
#   3. 保存后 dev server 自动重启，调试台标题变成 zhipu:glm-4-flash
# ---------------------------------------------------------------------------
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_MODEL_FALLBACK=glm-5.3-flash

# ---------------------------------------------------------------------------
# 备选：任意 OpenAI 兼容端点「直连」模式（Key 会进 bundle，仅本地临时用）
# 配了 VITE_LLM_URL 就会忽略上面的代理模式。
# ---------------------------------------------------------------------------
# VITE_LLM_URL=https://api.deepseek.com/chat/completions
# VITE_LLM_KEY=sk-xxxx
# VITE_LLM_MODEL=deepseek-chat
